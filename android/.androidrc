export ANDROID_HOME="$HOME/Library/Android/sdk"

_androidrc_jdk="$(/usr/libexec/java_home -v 17 2>/dev/null)"
if [ -n "$_androidrc_jdk" ]; then
    export JAVA_HOME="$_androidrc_jdk"
fi
unset _androidrc_jdk

# Prepend only directories that exist and aren't on PATH already. The existence
# check keeps a machine without the SDK from collecting dead PATH entries; the
# duplicate check makes re-sourcing this file a no-op, which matters because
# more than one rc file sources it and `source ~/.zshrc` is a common reflex.
#
# `sdkmanager`, `avdmanager`, and `apkanalyzer` live in cmdline-tools/latest/bin
# on current SDKs -- the old `tools/` and `tools/bin/` directories are gone.
for _androidrc_dir in \
    "$ANDROID_HOME/cmdline-tools/latest/bin" \
    "$ANDROID_HOME/platform-tools" \
    "$ANDROID_HOME/emulator"
do
    [ -d "$_androidrc_dir" ] || continue
    case ":$PATH:" in
        *":$_androidrc_dir:"*) ;;
        *) PATH="$_androidrc_dir:$PATH" ;;
    esac
done
unset _androidrc_dir
export PATH
