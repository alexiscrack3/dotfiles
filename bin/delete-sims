#!/usr/bin/env bash
#
# Delete iOS simulators whose name starts with "Shop Native".
#
# Usage:
#   delete-sims              Delete all matching simulators
#   delete-sims --select     Pick which ones to delete
#   delete-sims -s           Same as --select
#   delete-sims --dry-run    Show what would be deleted, delete nothing
#   delete-sims -n           Same as --dry-run
#
# --select and --dry-run can be combined.
#
set -euo pipefail

DRY_RUN=false
SELECT=false

while [[ $# -gt 0 ]]; do
  case "$1" in
    --dry-run|-n)
      DRY_RUN=true
      ;;
    --select|-s)
      SELECT=true
      ;;
    --help|-h)
      sed -n '3,12p' "$0" | sed 's/^# \{0,1\}//'
      exit 0
      ;;
    *)
      echo "Unknown option: $1" >&2
      echo "Usage: $0 [--select|-s] [--dry-run|-n]" >&2
      exit 1
      ;;
  esac
  shift
done

PREFIX="Shop Native"
DEVICES_DIR="${HOME}/Library/Developer/CoreSimulator/Devices"

# Disk usage of a simulator's data directory, in KB (0 if missing).
size_kb() {
  local udid="$1"
  local dir="${DEVICES_DIR}/${udid}"
  [[ -d "${dir}" ]] || { echo 0; return; }
  du -sk "${dir}" 2>/dev/null | awk '{print $1}'
}

# Convert KB to a human-readable size.
human_size() {
  local kb="$1"
  awk -v kb="${kb}" 'BEGIN {
    split("KB MB GB TB", units, " ");
    i = 1;
    size = kb;
    while (size >= 1024 && i < 4) { size /= 1024; i++ }
    printf (i == 1 ? "%d %s" : "%.1f %s"), size, units[i];
  }'
}

# Extract "<UDID><tab><name>" for every device whose name starts with PREFIX.
TAB=$'\t'
matches="$(
  xcrun simctl list devices \
    | grep -E "^[[:space:]]*${PREFIX}" \
    | sed -E "s/^[[:space:]]*(.*) \(([0-9A-Fa-f-]{36})\) \(.*/\2${TAB}\1/"
)" || true

if [[ -z "${matches}" ]]; then
  echo "No simulators found starting with \"${PREFIX}\"."
  exit 0
fi

udids=()
names=()
sizes=()
while IFS=$'\t' read -r udid name; do
  [[ -z "${udid}" ]] && continue
  udids+=("${udid}")
  names+=("${name}")
  sizes+=("$(size_kb "${udid}")")
done <<< "${matches}"

total="${#udids[@]}"

# Indices chosen for deletion; defaults to everything.
selected=()
for ((i = 0; i < total; i++)); do
  selected+=("${i}")
done

if ${SELECT}; then
  echo "Simulators starting with \"${PREFIX}\":"
  echo
  for ((i = 0; i < total; i++)); do
    printf "  %2d) %s (%s) — %s\n" \
      "$((i + 1))" "${names[i]}" "${udids[i]}" "$(human_size "${sizes[i]}")"
  done
  echo
  echo "Enter numbers to delete (e.g. \"1 3\" or \"1-3,5\"), \"all\", or blank to cancel."
  printf "> "
  if [[ -t 0 ]]; then
    read -r reply < /dev/tty || reply=""
  else
    read -r reply || reply=""
    echo "${reply}"
  fi

  reply="${reply//,/ }"
  if [[ -z "${reply// /}" ]]; then
    echo "Nothing selected. Aborting."
    exit 0
  fi

  if [[ "${reply}" == "all" || "${reply}" == "a" ]]; then
    :
  else
    selected=()
    for token in ${reply}; do
      if [[ "${token}" =~ ^([0-9]+)-([0-9]+)$ ]]; then
        start="${BASH_REMATCH[1]}"
        end="${BASH_REMATCH[2]}"
      elif [[ "${token}" =~ ^[0-9]+$ ]]; then
        start="${token}"
        end="${token}"
      else
        echo "Invalid selection: ${token}" >&2
        exit 1
      fi
      if (( start < 1 || end > total || start > end )); then
        echo "Selection out of range: ${token} (valid: 1-${total})" >&2
        exit 1
      fi
      for ((i = start; i <= end; i++)); do
        selected+=("$((i - 1))")
      done
    done

    # Drop duplicates so a simulator listed twice is only deleted once.
    selected=($(printf '%s\n' "${selected[@]}" | sort -n -u))
  fi

  if [[ "${#selected[@]}" -eq 0 ]]; then
    echo "Nothing selected. Aborting."
    exit 0
  fi
  echo
fi

count=0
total_kb=0
for i in "${selected[@]}"; do
  count=$((count + 1))
  total_kb=$((total_kb + sizes[i]))
  human="$(human_size "${sizes[i]}")"
  if ${DRY_RUN}; then
    echo "[dry-run] Would delete: ${names[i]} (${udids[i]}) — ${human}"
  else
    echo "Deleting: ${names[i]} (${udids[i]}) — ${human}"
    xcrun simctl shutdown "${udids[i]}" 2>/dev/null || true
    xcrun simctl delete "${udids[i]}"
  fi
done

total_human="$(human_size "${total_kb}")"
if ${DRY_RUN}; then
  echo "Dry run complete. ${count} simulator(s) would be deleted, freeing ${total_human}."
else
  echo "Done. Deleted ${count} simulator(s), freed ${total_human}."
fi
