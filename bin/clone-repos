#!/usr/bin/env bash
#
# Clone repositories from a GitHub account, chosen interactively.
#
# Usage:
#   clone-repos [owner]      List repos for owner (default: your GitHub login)
#
# Options:
#   --dest DIR, -d DIR       Clone into DIR (default: ~/src/github.com/<owner>)
#   --limit N, -L N          Maximum repos to list (default: 200)
#   --archived               Include archived repositories
#   --forks                  Include forks
#   --list-orgs              List organizations you belong to, then exit
#   --dry-run, -n            Show what would be cloned, clone nothing
#   --help, -h               Show this help
#
# Requires the GitHub CLI: brew install gh && gh auth login
#
set -euo pipefail

TAB=$'\t'

usage() {
  awk 'NR < 3 { next } /^#/ { sub(/^#[[:space:]]?/, ""); print; next } { exit }' "$0"
}

OWNER=""
DEST=""
LIMIT=200
ARCHIVED=false
FORKS=false
LIST_ORGS=false
DRY_RUN=false

while [[ $# -gt 0 ]]; do
  case "$1" in
    --dest|-d)
      if [[ $# -lt 2 ]]; then
        echo "Missing directory after $1." >&2
        exit 1
      fi
      DEST="$2"
      shift
      ;;
    --limit|-L)
      if [[ $# -lt 2 ]]; then
        echo "Missing number after $1." >&2
        exit 1
      fi
      if [[ ! "$2" =~ ^[0-9]+$ ]] || (( $2 < 1 )); then
        echo "Invalid limit: $2" >&2
        exit 1
      fi
      LIMIT="$2"
      shift
      ;;
    --archived)
      ARCHIVED=true
      ;;
    --forks)
      FORKS=true
      ;;
    --list-orgs)
      LIST_ORGS=true
      ;;
    --dry-run|-n)
      DRY_RUN=true
      ;;
    --help|-h)
      usage
      exit 0
      ;;
    -*)
      echo "Unknown option: $1" >&2
      echo >&2
      usage >&2
      exit 1
      ;;
    *)
      if [[ -n "${OWNER}" ]]; then
        echo "Only one owner may be given (got \"${OWNER}\" and \"$1\")." >&2
        exit 1
      fi
      OWNER="$1"
      ;;
  esac
  shift
done

if ! command -v gh >/dev/null 2>&1; then
  echo "Cannot list repositories: gh not found." >&2
  echo "Install it with: brew install gh" >&2
  exit 1
fi

if ! gh auth status >/dev/null 2>&1; then
  echo "Cannot list repositories: gh is not authenticated." >&2
  echo "Log in with: gh auth login" >&2
  exit 1
fi

if ${LIST_ORGS}; then
  gh api user/orgs --paginate --jq '.[].login'
  exit 0
fi

if [[ -z "${OWNER}" ]]; then
  OWNER="$(gh api user --jq .login)"
fi

if [[ -z "${DEST}" ]]; then
  DEST="${HOME}/src/github.com/${OWNER}"
fi

# gh's own timeago formatter keeps the "2 days ago" column free of date math.
list_repos() {
  local filters=()
  ${ARCHIVED} || filters+=(--no-archived)
  ${FORKS} || filters+=(--source)
  gh repo list "${OWNER}" --limit "${LIMIT}" "${filters[@]}" \
    --json name,visibility,pushedAt \
    --template '{{range .}}{{.name}}{{"\t"}}{{.visibility}}{{"\t"}}{{timeago .pushedAt}}{{"\n"}}{{end}}'
}

names=()
visibilities=()
ages=()
cloned=()

rows="$(list_repos)" || {
  echo "Failed to list repositories for \"${OWNER}\"." >&2
  exit 1
}

while IFS="${TAB}" read -r name visibility age; do
  [[ -n "${name}" ]] || continue
  names+=("${name}")
  visibilities+=("$(printf '%s' "${visibility}" | tr '[:upper:]' '[:lower:]')")
  ages+=("${age}")
  if [[ -d "${DEST}/${name}/.git" ]]; then
    cloned+=(true)
  else
    cloned+=(false)
  fi
done <<< "${rows}"

total="${#names[@]}"

if (( total == 0 )); then
  echo "No repositories found for \"${OWNER}\"."
  exit 0
fi

NAME_HEADER="REPOSITORY"
VIS_HEADER="VISIBILITY"
AGE_HEADER="LAST PUSH"

# Index column grows with the list, so a 100+ row listing stays aligned.
idx_width="${#total}"
(( idx_width < 2 )) && idx_width=2

# Indent matching the "  %*d) " row prefix, so headers sit over their columns.
HEADER_INDENT="$(printf '%*s' "$((idx_width + 4))" '')"

# Widest value in each column, headers included, so everything lines up.
name_width="${#NAME_HEADER}"
vis_width="${#VIS_HEADER}"
age_width="${#AGE_HEADER}"
for ((i = 0; i < total; i++)); do
  (( ${#names[i]} > name_width )) && name_width="${#names[i]}"
  (( ${#visibilities[i]} > vis_width )) && vis_width="${#visibilities[i]}"
  (( ${#ages[i]} > age_width )) && age_width="${#ages[i]}"
done

# A row of dashes n characters wide.
rule() {
  printf '%*s' "$1" '' | tr ' ' '-'
}

echo "Repositories for ${OWNER}:"
echo
printf "%s%-*s  %-*s  %s\n" \
  "${HEADER_INDENT}" \
  "${name_width}" "${NAME_HEADER}" \
  "${vis_width}" "${VIS_HEADER}" \
  "${AGE_HEADER}"
printf "%s%s  %s  %s\n" \
  "${HEADER_INDENT}" \
  "$(rule "${name_width}")" \
  "$(rule "${vis_width}")" \
  "$(rule "${age_width}")"
for ((i = 0; i < total; i++)); do
  # Pad the age column only when a marker follows it, to avoid trailing blanks.
  if ${cloned[i]}; then
    printf "  %*d) %-*s  %-*s  %-*s  [cloned]\n" \
      "${idx_width}" "$((i + 1))" \
      "${name_width}" "${names[i]}" \
      "${vis_width}" "${visibilities[i]}" \
      "${age_width}" "${ages[i]}"
  else
    printf "  %*d) %-*s  %-*s  %s\n" \
      "${idx_width}" "$((i + 1))" \
      "${name_width}" "${names[i]}" \
      "${vis_width}" "${visibilities[i]}" \
      "${ages[i]}"
  fi
done
echo
echo "Enter numbers to clone (e.g. \"1 3\" or \"1-3,5\"), \"all\", or blank to cancel."
printf "> "
if [[ -t 0 ]]; then
  read -r reply < /dev/tty || reply=""
else
  read -r reply || reply=""
  echo "${reply}"
fi

reply="${reply//,/ }"
if [[ -z "${reply// /}" ]]; then
  echo "Nothing selected. Aborting."
  exit 0
fi

selected=()
if [[ "${reply}" == "all" || "${reply}" == "a" ]]; then
  for ((i = 0; i < total; i++)); do
    selected+=("${i}")
  done
else
  for token in ${reply}; do
    if [[ "${token}" =~ ^([0-9]+)-([0-9]+)$ ]]; then
      start="${BASH_REMATCH[1]}"
      end="${BASH_REMATCH[2]}"
    elif [[ "${token}" =~ ^[0-9]+$ ]]; then
      start="${token}"
      end="${token}"
    else
      echo "Invalid selection: ${token}" >&2
      exit 1
    fi
    if (( start < 1 || end > total || start > end )); then
      echo "Selection out of range: ${token} (valid: 1-${total})" >&2
      exit 1
    fi
    for ((i = start; i <= end; i++)); do
      selected+=("$((i - 1))")
    done
  done

  # Drop duplicates so a repo listed twice is only cloned once.
  selected=($(printf '%s\n' "${selected[@]}" | sort -n -u))
fi

if (( ${#selected[@]} == 0 )); then
  echo "Nothing selected. Aborting."
  exit 0
fi
echo

count=0
skipped=0
failed=0
for i in "${selected[@]}"; do
  name="${names[i]}"
  target="${DEST}/${name}"

  if ${cloned[i]}; then
    echo "Skipping ${name}: already cloned at ${target}"
    skipped=$((skipped + 1))
    continue
  fi

  if ${DRY_RUN}; then
    echo "[dry-run] Would clone ${OWNER}/${name} into ${target}"
    count=$((count + 1))
    continue
  fi

  echo "Cloning ${OWNER}/${name}…"
  if gh repo clone "${OWNER}/${name}" "${target}"; then
    count=$((count + 1))
  else
    echo "  Failed to clone ${OWNER}/${name}" >&2
    failed=$((failed + 1))
  fi
done

if ${DRY_RUN}; then
  echo "Dry run complete. ${count} repo(s) would be cloned, ${skipped} already present."
else
  echo "Done. Cloned ${count} repo(s), ${skipped} already present."
  if (( failed > 0 )); then
    echo "${failed} repo(s) could not be cloned." >&2
    exit 1
  fi
fi
